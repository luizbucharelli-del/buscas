# Chave da API Atlasender — NUNCA commitar o valor real.
# Fica apenas no servidor (sem prefixo NEXT_PUBLIC_).
ATLASENDER_API_KEY=
ATLASENDER_BASE_URL=https://atlasender.com/api/cpf/v1
ATLASENDER_TIMEOUT_MS=10000

# Acesso ao painel (HTTP Basic Auth). Obrigatório — os dados retornados são pessoais (LGPD).
APP_USERNAME=
APP_PASSWORD=

# Limite de consultas por IP a cada minuto.
RATE_LIMIT_PER_MINUTE=10
